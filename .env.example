# ==============================================================================
# QM-Nachhaltigkeit (DGNB / QNG / BNB) - Environment Variable Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Runtime Configuration
# ------------------------------------------------------------------------------
# PORT: Port on which the Express server listens (default: 3000)
PORT=3000

# NODE_ENV: Application environment mode ('development' | 'production' | 'test')
# When set to 'production':
# - Error stack traces and internal exceptions are suppressed from API responses (F7)
# - Security headers (nosniff, frameguard, etc.) are enforced (F8)
# - ALLOW_UNAUTHENTICATED_API bypass is strictly blocked (F3)
NODE_ENV=development

# ALLOW_UNAUTHENTICATED_API: Set to 'true' to bypass Firebase authentication for local dev or automated testing.
# IMPORTANT: This bypass is automatically blocked and ignored when NODE_ENV=production (F3).
ALLOW_UNAUTHENTICATED_API=false

# ------------------------------------------------------------------------------
# 2. Artificial Intelligence (Google Gemini API)
# ------------------------------------------------------------------------------
# GEMINI_API_KEY: Google Gemini API key required for PDF parsing and standards evaluation.
# Obtain from Google AI Studio (https://aistudio.google.com/app/apikey).
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# GEMINI_MODEL: Primary Gemini model for document extraction and criteria analysis (default: gemini-2.5-flash).
# Fallbacks: gemini-2.5-flash -> gemini-2.0-flash
GEMINI_MODEL="gemini-2.5-flash"

# ------------------------------------------------------------------------------
# 3. Access Control & Email Whitelists (F4)
# ------------------------------------------------------------------------------
# ADMIN_EMAILS: Comma-separated list of administrator email addresses.
# Admins can manage the company vault, set/reset the company passphrase, and view all audits.
ADMIN_EMAILS="brian.lackmann@kaubit.de,brianlackmann@gmail.com"

# ALLOWED_EMAILS: Comma-separated list of authorized employee/auditor email addresses.
# Only users with emails in this list (or ADMIN_EMAILS) are granted access after Google Sign-In.
ALLOWED_EMAILS="brian.lackmann@kaubit.de,brianlackmann@gmail.com,admin@dgnb-qm.de,auditor@bau-qm.org"

# ------------------------------------------------------------------------------
# 4. Firebase & Cloud Firestore Configuration
# (Vite is configured with envPrefix: ['VITE_', 'FIREBASE_'], so these variables
# are automatically accessible in both the Node server and the React frontend bundle)
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="gen-lang-client-0723441171"
FIREBASE_APP_ID="1:226570021817:web:d6a0d76f02bd32e409a468"
FIREBASE_API_KEY="AIzaSyDb0vNFTYwimfrgjpfdbWpIMRw9TdNx1lg"
FIREBASE_AUTH_DOMAIN="gen-lang-client-0723441171.firebaseapp.com"
FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-dgnbenv12qmprfto-9665ebc6-a4b9-418d-9d5d-967112a73de4"
FIREBASE_STORAGE_BUCKET="gen-lang-client-0723441171.firebasestorage.app"
FIREBASE_MESSAGING_SENDER_ID="226570021817"

# ------------------------------------------------------------------------------
# 5. Obsolete / Deprecated Variables (Retained for Reference)
# ------------------------------------------------------------------------------
# APP_URL: Optional host URL. Currently unused by the backend and frontend code.
# APP_URL="http://localhost:3000"
